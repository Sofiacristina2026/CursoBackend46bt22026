APP_NAME=SENAI Supply
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# Banco de dados PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=senai_supply
DB_USERNAME=postgres
DB_PASSWORD=

# Sessões
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=null

# Logs
LOG_CHANNEL=single
LOG_LEVEL=debug
